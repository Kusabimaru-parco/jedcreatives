---
// One viewer for the whole page. Anything with [data-lightbox] opens it on click:
//   data-lightbox="video" | "image"
//   data-lb-src, data-lb-poster (video), data-lb-alt (image),
//   data-lb-watch (YouTube/Vimeo link — embedded instead of the local preview), data-lb-vertical,
//   data-lb-phone (show the video on an iPhone with a Reels-style screen),
//   data-lb-title, data-lb-category, data-lb-description (all optional)
// The clicked card itself lifts out of the page and grows into the viewer (its spot stays empty), then
// shrinks back into place on close. The card is the closest [data-video-card] around the trigger, or the
// trigger itself (hero cards). A card's click handler can preventDefault() to stop it opening.
import PhoneShell from './PhoneShell.astro';
import { asset } from '../lib/asset';
---

<dialog id="lightbox" class="lightbox" aria-labelledby="lb-title">
	<div class="lb-inner" data-lb-inner>
		<!-- Sized to the media's own aspect ratio (or the phone's), so nothing is letterboxed. -->
		<div class="lb-frame" data-lb-frame>
			<div class="lb-plain" data-lb-plain></div>

			<PhoneShell class="lb-phone">
				<div class="lb-phone-media" data-lb-phone-media></div>

				<!-- Reels-style screen UI -->
				<div class="reel-ui" data-reel-ui>
					<div class="status" aria-hidden="true">
						<span>9:41</span>
						<span class="icons">
							<svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg>
							<svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.4 6.8a6.6 6.6 0 0 1 9.2 0l-1.4 1.5a4.6 4.6 0 0 0-6.4 0zM1.1 4.5a9.8 9.8 0 0 1 13.8 0l-1.4 1.5a7.8 7.8 0 0 0-11 0z"></path></svg>
							<svg viewBox="0 0 26 12"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity="0.5"></rect><rect x="2.5" y="2.5" width="16" height="7" rx="2"></rect><rect x="23.5" y="4" width="2" height="4" rx="1" opacity="0.5"></rect></svg>
						</span>
					</div>
					<div class="top-label" aria-hidden="true">Reels</div>

					<!-- Tap the screen to pause / play, like Reels -->
					<button type="button" class="tap" aria-label="Pause" data-reel-toggle>
						<span class="big-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg></span>
					</button>
					<button type="button" class="mute" aria-label="Mute" data-reel-mute>
						<svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						<svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zM17 9l5 6M22 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</button>

					<div class="actions" aria-hidden="true">
						<span><svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 3 4.5 6.7 4.5c2.2 0 3.6 1.2 5.3 3.1 1.7-1.9 3.1-3.1 5.3-3.1 3.7 0 5.8 3.8 4.3 7.2C19.5 16.4 12 21 12 21z"></path></svg>4.8K</span>
						<span><svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L3 21l1.9-5.4A8.5 8.5 0 1 1 21 11.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>126</span>
						<span><svg viewBox="0 0 24 24"><path d="M22 3 2 10.5l7.5 3 3 7.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><path d="m9.5 13.5 5-5" stroke="currentColor" stroke-width="2"></path></svg></span>
						<span><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="12" r="2"></circle></svg></span>
					</div>

					<div class="caption" aria-hidden="true">
						<div class="who">
							<img src={asset('img/logo-white.png')} alt="" width="114" height="128" />
							<b>jhmeooo_</b>
							<span class="follow">Follow</span>
						</div>
						<p class="reel-title" data-reel-title></p>
						<p class="reel-meta" data-reel-meta></p>
					</div>

					<div class="progress" aria-hidden="true"><i></i></div>
					<div class="home" aria-hidden="true"></div>
				</div>
			</PhoneShell>
		</div>

		<div class="lb-info mt-4 sm:mt-5">
			<span class="pill px-2.5 py-1 text-[0.625rem]" data-lb-category></span>
			<h2 id="lb-title" class="mt-2 text-base font-semibold text-white sm:text-lg" data-lb-title></h2>
			<p class="mt-1 max-w-2xl text-sm leading-relaxed text-white/70" data-lb-description></p>
		</div>
	</div>

	<button type="button" class="lb-close btn size-11 p-0" aria-label="Close" data-lb-close>
		<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6">
			<path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round"></path>
		</svg>
	</button>
</dialog>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 4.5rem 1rem 1.5rem;
		border: 0;
		background: transparent;
		color: #fff;
		display: none;
		place-items: center;
		overflow: hidden auto;
	}
	.lightbox[open] {
		display: grid;
	}
	.lightbox::backdrop {
		background: rgb(2 4 15 / 0.9);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition: opacity 0.4s var(--ease-soft);
	}
	.lightbox[open]::backdrop {
		animation: lb-fade 0.45s var(--ease-soft);
	}
	.lightbox.is-closing::backdrop {
		opacity: 0;
	}
	@media (min-width: 40rem) {
		.lightbox {
			padding: 5rem 2rem 2rem;
		}
	}

	/* --ar = width / height of the box. As wide as possible while its height still fits the screen
	   (leaving room for the caption); the caption lines up under it. */
	.lb-inner {
		--ar: 1.7778;
		width: min(100%, 72rem, calc((100svh - 14rem) * var(--ar)));
	}
	.lb-frame {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ar);
		border-radius: 16px;
		overflow: hidden;
		background: #000;
		box-shadow:
			0 30px 80px -20px rgb(0 0 0 / 0.8),
			0 0 0 1px rgb(255 255 255 / 0.1);
		transform-origin: 0 0;
		will-change: transform;
	}
	.lb-plain {
		position: absolute;
		inset: 0;
	}
	.lb-plain :global(video),
	.lb-plain :global(img),
	.lb-plain :global(iframe),
	.lb-phone-media :global(video),
	.lb-phone-media :global(iframe) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 0;
	}

	/* ---------- Phone mode ---------- */
	.lb-frame:not(.is-phone) :global(.lb-phone) {
		display: none;
	}
	.lb-frame.is-phone {
		overflow: visible;
		background: none;
		box-shadow: none;
		border-radius: 0;
	}
	.lb-frame.is-phone .lb-plain {
		display: none;
	}
	.lb-frame :global(.lb-phone) {
		position: absolute;
		inset: 0;
	}
	.lb-phone-media {
		position: absolute;
		inset: 0;
	}

	/* Reels UI — sized in cqw of the phone. */
	.reel-ui {
		position: absolute;
		inset: 0;
		z-index: 1;
		color: #fff;
		font-size: 3.6cqw;
		text-shadow: 0 0.3cqw 1cqw rgb(0 0 0 / 0.5);
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 18%),
			linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 38%);
		pointer-events: none;
	}
	.reel-ui.is-hidden {
		display: none;
	}
	.status {
		position: absolute;
		top: 4.6cqw;
		left: 8.5cqw;
		right: 7cqw;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 4.2cqw;
		font-weight: 600;
	}
	.status .icons {
		display: flex;
		gap: 1.4cqw;
	}
	.status svg {
		height: 3.3cqw;
		width: auto;
		fill: currentColor;
	}
	.top-label {
		position: absolute;
		top: 16cqw;
		left: 6cqw;
		font-size: 5.6cqw;
		font-weight: 700;
	}
	.tap {
		position: absolute;
		inset: 0;
		pointer-events: auto;
		cursor: var(--cur-pointer);
	}
	.big-play {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		width: 18cqw;
		height: 18cqw;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.35);
		opacity: 0;
		scale: 1.3;
		transition:
			opacity 0.25s,
			scale 0.25s var(--ease-soft);
	}
	.big-play svg {
		width: 9cqw;
		fill: #fff;
		margin-left: 1cqw;
	}
	.reel-ui.is-paused .big-play {
		opacity: 1;
		scale: 1;
	}
	.tap:focus-visible {
		outline: 2px solid var(--color-cyan);
		outline-offset: -4px;
		border-radius: 14cqw;
	}
	.mute {
		position: absolute;
		top: 15cqw;
		right: 5cqw;
		display: grid;
		place-items: center;
		width: 9cqw;
		height: 9cqw;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.35);
		pointer-events: auto;
		cursor: var(--cur-pointer);
	}
	.mute svg {
		width: 5cqw;
	}
	.mute .off,
	.reel-ui.is-muted .mute .on {
		display: none;
	}
	.reel-ui.is-muted .mute .off {
		display: block;
	}
	.actions {
		position: absolute;
		right: 4.5cqw;
		bottom: 30cqw;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5cqw;
		font-size: 3cqw;
		font-weight: 600;
	}
	.actions span {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1cqw;
	}
	.actions svg {
		width: 7.5cqw;
		height: 7.5cqw;
		fill: currentColor;
	}
	.caption {
		position: absolute;
		left: 5.5cqw;
		right: 18cqw;
		bottom: 11cqw;
	}
	.who {
		display: flex;
		align-items: center;
		gap: 2cqw;
	}
	.who img {
		width: 7.5cqw;
		height: 7.5cqw;
		padding: 1.4cqw;
		border-radius: 50%;
		object-fit: contain;
		background: #1e4dff;
		border: 0.4cqw solid #fff;
	}
	.follow {
		padding: 0.6cqw 2.2cqw;
		border-radius: 1.6cqw;
		border: 0.3cqw solid rgb(255 255 255 / 0.8);
		font-size: 3cqw;
		font-weight: 600;
	}
	.reel-title,
	.reel-meta {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.reel-title {
		margin-top: 2cqw;
		font-weight: 500;
	}
	.reel-meta {
		margin-top: 1.2cqw;
		font-size: 3cqw;
		opacity: 0.85;
	}
	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 6.5cqw;
		height: 0.6cqw;
		background: rgb(255 255 255 / 0.25);
	}
	.progress i {
		display: block;
		height: 100%;
		width: calc(var(--progress, 0) * 100%);
		background: #fff;
	}
	.home {
		position: absolute;
		left: 50%;
		bottom: 2.2cqw;
		translate: -50% 0;
		width: 34cqw;
		height: 1.3cqw;
		border-radius: 999px;
		background: #fff;
	}

	/* Caption and close button follow the expand; they leave first on close. */
	.lightbox[open] .lb-info,
	.lightbox[open] .lb-close {
		animation: lb-rise 0.5s var(--ease-soft) 0.25s both;
	}
	.lightbox.is-closing .lb-info,
	.lightbox.is-closing .lb-close {
		opacity: 0;
		transition: opacity 0.15s;
	}
	.lb-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
	}
	@media (min-width: 40rem) {
		.lb-close {
			top: 1.5rem;
			right: 2rem;
		}
	}

	@keyframes lb-fade {
		from {
			opacity: 0;
		}
	}
	@keyframes lb-rise {
		from {
			opacity: 0;
			translate: 0 10px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lightbox[open]::backdrop,
		.lightbox[open] .lb-info,
		.lightbox[open] .lb-close {
			animation: none;
		}
	}

	/* No page scrolling behind the open viewer. */
	:global(html:has(dialog#lightbox[open])) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

	if (dialog) {
		const inner = dialog.querySelector<HTMLElement>('[data-lb-inner]')!;
		const frame = dialog.querySelector<HTMLElement>('[data-lb-frame]')!;
		const plain = dialog.querySelector<HTMLElement>('[data-lb-plain]')!;
		const phoneMedia = dialog.querySelector<HTMLElement>('[data-lb-phone-media]')!;
		const reelUi = dialog.querySelector<HTMLElement>('[data-reel-ui]')!;
		const reelToggle = dialog.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
		const reelMute = dialog.querySelector<HTMLButtonElement>('[data-reel-mute]')!;
		const titleEl = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
		const categoryEl = dialog.querySelector<HTMLElement>('[data-lb-category]')!;
		const descEl = dialog.querySelector<HTMLElement>('[data-lb-description]')!;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const EASE_OUT = 'cubic-bezier(0.22, 0.75, 0.25, 1)';
		const EASE_IN = 'cubic-bezier(0.55, 0, 0.35, 1)';
		const PHONE_AR = 71.6 / 146.6;

		let source: HTMLElement | null = null; // the card's visible box (measured for the motion)
		let card: HTMLElement | null = null; // the element hidden while it is "lifted out"
		let cardVideo: HTMLVideoElement | null = null;
		let cardWasPlaying = false;
		let closing = false;
		let openedWithPointer = false;

		const setText = (el: HTMLElement, text?: string) => {
			el.textContent = text ?? '';
			el.hidden = !text;
		};
		const setRatio = (ar: number) => {
			if (ar > 0 && Number.isFinite(ar)) inner.style.setProperty('--ar', ar.toFixed(4));
		};
		const currentVideo = () => frame.querySelector<HTMLVideoElement>('video');

		// YouTube / Vimeo share link → embeddable player URL (autoplay with sound; the click allows it).
		const embedUrl = (link: string) => {
			try {
				const u = new URL(link);
				const host = u.hostname.replace(/^www\.|^m\./, '');
				let id: string | null = null;
				if (host === 'youtu.be') id = u.pathname.slice(1);
				else if (host.endsWith('youtube.com')) id = u.searchParams.get('v') ?? u.pathname.match(/\/(?:shorts|embed|live)\/([\w-]+)/)?.[1] ?? null;
				if (id) return `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
				if (host.endsWith('vimeo.com')) {
					const [vid, hash] = u.pathname.split('/').filter(Boolean).filter((p) => p !== 'video');
					if (vid && /^\d+$/.test(vid)) return `https://player.vimeo.com/video/${vid}?autoplay=1${hash ? `&h=${hash}` : ''}&title=0&byline=0&portrait=0&dnt=1`;
				}
			} catch {}
			return null;
		};

		const isOnScreen = (r: DOMRect) => r.width > 0 && r.height > 0 && r.bottom > 0 && r.top < innerHeight;
		const radiusOf = (el: HTMLElement) => parseFloat(getComputedStyle(el).borderTopLeftRadius) || 16;

		// FLIP: keyframes that take the frame from the card's box to its own place in the viewer.
		const fromCard = (from: DOMRect, radius: number): Keyframe[] => {
			const to = frame.getBoundingClientRect();
			const sx = from.width / to.width;
			const sy = from.height / to.height;
			const end = frame.classList.contains('is-phone') ? '0px' : '16px';
			return [
				{
					transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${sx}, ${sy})`,
					borderRadius: `${radius / sx}px / ${radius / sy}px`,
				},
				{ transform: 'none', borderRadius: end },
			];
		};

		// Reels phone controls
		const syncReelUi = () => {
			const v = currentVideo();
			reelUi.classList.toggle('is-paused', !!v?.paused);
			reelUi.classList.toggle('is-muted', !!v?.muted);
			reelToggle.setAttribute('aria-label', v?.paused ? 'Play' : 'Pause');
			reelMute.setAttribute('aria-label', v?.muted ? 'Unmute' : 'Mute');
		};
		reelToggle.addEventListener('click', () => {
			const v = currentVideo();
			if (!v) return;
			v.paused ? v.play().catch(() => {}) : v.pause();
		});
		reelMute.addEventListener('click', () => {
			const v = currentVideo();
			if (!v) return;
			v.muted = !v.muted;
			syncReelUi();
		});

		const open = (trigger: HTMLElement) => {
			const d = trigger.dataset;
			const isVideo = d.lightbox === 'video';
			const vertical = d.lbVertical !== undefined;
			const phone = isVideo && d.lbPhone !== undefined;

			card = trigger.closest<HTMLElement>('[data-video-card]') ?? trigger;
			source = card.matches('[data-video-card]') ? card : (card.querySelector<HTMLElement>('.hv-face') ?? card);
			cardVideo = card.querySelector('video');
			plain.replaceChildren();
			phoneMedia.replaceChildren();
			frame.classList.toggle('is-phone', phone);
			const target = phone ? phoneMedia : plain;

			// Box shape: the phone, or the media's real shape when the card already knows it.
			setRatio(
				phone ? PHONE_AR
				: cardVideo?.videoWidth ? cardVideo.videoWidth / cardVideo.videoHeight
				: !isVideo && card.querySelector('img')?.naturalWidth ? card.querySelector('img')!.naturalWidth / card.querySelector('img')!.naturalHeight
				: vertical ? 9 / 16 : 16 / 9,
			);

			const embed = isVideo && d.lbWatch ? embedUrl(d.lbWatch) : null;
			reelUi.classList.toggle('is-hidden', !!embed); // YouTube/Vimeo bring their own controls
			if (embed) {
				const player = document.createElement('iframe');
				player.src = embed;
				player.title = d.lbTitle ?? 'Project video';
				player.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
				player.allowFullscreen = true;
				if (!phone) setRatio(vertical ? 9 / 16 : 16 / 9);
				target.append(player);
			} else if (isVideo && d.lbSrc) {
				const video = document.createElement('video');
				video.src = d.lbSrc;
				if (d.lbPoster) video.poster = d.lbPoster;
				video.controls = !phone; // the phone has Reels-style tap controls instead
				video.muted = false;
				video.playsInline = true;
				video.loop = true;
				video.preload = 'auto';
				video.setAttribute('aria-label', d.lbTitle ?? 'Project video');
				if (!phone) video.addEventListener('loadedmetadata', () => setRatio(video.videoWidth / video.videoHeight));
				if (phone) {
					for (const ev of ['play', 'pause', 'volumechange']) video.addEventListener(ev, syncReelUi);
					video.addEventListener('timeupdate', () => {
						if (video.duration) reelUi.style.setProperty('--progress', (video.currentTime / video.duration).toFixed(3));
					});
				}
				// Continue from where the card was, so it feels like the same video growing.
				if (cardVideo && cardVideo.currentTime > 0 && cardVideo.currentSrc.endsWith(d.lbSrc.split('/').pop()!)) {
					video.currentTime = cardVideo.currentTime;
				}
				target.append(video);
				video.play().catch(() => {}); // the click is a user gesture, so sound is allowed
			} else if (d.lbSrc) {
				const img = document.createElement('img');
				img.src = d.lbSrc;
				img.alt = d.lbAlt ?? '';
				img.addEventListener('load', () => setRatio(img.naturalWidth / img.naturalHeight));
				target.append(img);
			} else return;

			setText(titleEl, d.lbTitle ?? (d.lightbox === 'image' ? d.lbAlt : undefined));
			setText(categoryEl, d.lbCategory);
			setText(descEl, d.lbDescription);
			dialog.querySelector('[data-reel-title]')!.textContent = d.lbTitle ?? '';
			dialog.querySelector('[data-reel-meta]')!.textContent = `♪ Original audio · ${d.lbCategory ?? ''}`;
			reelUi.style.setProperty('--progress', '0');
			syncReelUi();

			const from = source.getBoundingClientRect();
			const radius = radiusOf(source);
			closing = false;
			dialog.classList.remove('is-closing');
			dialog.showModal();

			// The card lifts out of the page: its spot stays empty while the viewer is open.
			card.style.visibility = 'hidden';
			cardWasPlaying = !!cardVideo && !cardVideo.paused;
			cardVideo?.pause();

			if (reduceMotion) return;
			if (isOnScreen(from)) {
				frame.animate(fromCard(from, radius), { duration: 650, easing: EASE_OUT });
			} else {
				frame.animate([{ opacity: 0, transform: 'scale(0.94)' }, { opacity: 1, transform: 'none' }], { duration: 400, easing: EASE_OUT });
			}
		};

		// Put the card back. Fades in when `fade` is given, so it crossfades with the shrinking player.
		// Its hover effects stay off until the pointer leaves it, so it doesn't jump into its hover state
		// just because the mouse happens to be resting on it.
		const revealCard = (fade = 0) => {
			if (!card || card.style.visibility !== 'hidden') return;
			const el = card;
			el.dataset.lbReturning = '';
			el.style.visibility = '';
			if (fade) el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: fade, easing: 'linear' });
			const done = () => delete el.dataset.lbReturning;
			el.addEventListener('pointerleave', done, { once: true });
			setTimeout(done, 2500);
		};

		const finish = () => {
			revealCard(); // before closing, so there is never a frame with neither on screen
			currentVideo()?.pause();
			const back = card;
			dialog.close();
			// The browser hands focus back to the card. If it was opened with the mouse, drop that focus —
			// otherwise (e.g. after closing with Esc) the card would show its keyboard-focus state and grow.
			if (openedWithPointer && back?.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
		};

		// Fly back into the card's spot (or fade if it is no longer on screen), then close. Over the last part
		// of the flight the player fades out while the card fades in, so the hand-over is a crossfade, not a
		// swap (hero cards are tilted in 3D, the player is flat).
		const close = () => {
			if (!dialog.open || closing) return;
			closing = true;
			dialog.classList.add('is-closing');
			if (reduceMotion) return finish();

			const to = source?.isConnected ? source.getBoundingClientRect() : null;
			let anim: Animation;
			if (to && isOnScreen(to) && frame.classList.contains('is-phone')) {
				// Phone: the Reels UI fades off first, then the phone shrinks evenly (no squashing — a phone is
				// narrower than the card) onto the card's centre and dissolves gradually while the card fades in.
				const D = 720;
				const HANDOFF = 0.35;
				const from = frame.getBoundingClientRect();
				const sc = to.height / from.height;
				const dx = to.left + to.width / 2 - (from.left + (from.width * sc) / 2);
				const dy = to.top - from.top;
				reelUi.animate([{ opacity: 1 }, { opacity: 0 }], { duration: D * 0.35, easing: 'ease-out', fill: 'forwards' });
				anim = frame.animate(
					[
						{ transform: 'none', filter: 'blur(0px)' },
						{ transform: `translate(${dx}px, ${dy}px) scale(${sc})`, filter: 'blur(3px)' },
					],
					{ duration: D, easing: EASE_IN, fill: 'forwards' },
				);
				frame.animate([{ opacity: 1 }, { opacity: 1, offset: HANDOFF }, { opacity: 0 }], { duration: D, easing: 'ease-in', fill: 'forwards' });
				setTimeout(() => revealCard(D * (1 - HANDOFF)), D * HANDOFF);
			} else if (to && isOnScreen(to)) {
				const D = 560;
				const HANDOFF = 0.7;
				anim = frame.animate(fromCard(to, radiusOf(source!)).reverse(), { duration: D, easing: EASE_IN, fill: 'forwards' });
				frame.animate([{ opacity: 1 }, { opacity: 1, offset: HANDOFF }, { opacity: 0 }], { duration: D, fill: 'forwards' });
				setTimeout(() => revealCard(D * (1 - HANDOFF)), D * HANDOFF);
			} else {
				anim = frame.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(0.95)' }], { duration: 300, easing: EASE_IN, fill: 'forwards' });
			}
			anim.finished.then(finish, finish);
		};

		// After closing: put the card back (continuing from where the viewer was) and clean up.
		dialog.addEventListener('close', () => {
			const v = currentVideo();
			revealCard();
			if (cardVideo) {
				if (v && v.currentSrc && cardVideo.currentSrc.endsWith(v.currentSrc.split('/').pop()!)) cardVideo.currentTime = v.currentTime;
				if (cardWasPlaying) cardVideo.play().catch(() => {});
			}
			frame.getAnimations({ subtree: true }).forEach((a) => a.cancel());
			plain.replaceChildren();
			phoneMedia.replaceChildren();
			dialog.classList.remove('is-closing');
			closing = false;
			card = source = cardVideo = null;
		});

		// Esc animates too.
		dialog.addEventListener('cancel', (e) => {
			e.preventDefault();
			close();
		});
		dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
		// Click on the dimmed area (outside the media and caption) closes.
		dialog.addEventListener('click', (e) => {
			const t = e.target as HTMLElement;
			if (t === dialog || t === inner) close();
		});

		document.addEventListener('click', (e) => {
			if (e.defaultPrevented) return; // e.g. a card's first tap on touch only shows its info
			const trigger = (e.target as Element).closest<HTMLElement>('[data-lightbox]');
			if (!trigger || dialog.contains(trigger)) return;
			e.preventDefault(); // hero cards are links (fallback without JS)
			openedWithPointer = (e as MouseEvent).detail > 0; // 0 = activated from the keyboard
			open(trigger);
		});
	}
</script>

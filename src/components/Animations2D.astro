---
import SectionTitle from './SectionTitle.astro';
import VideoCard from './VideoCard.astro';
import { animations2D } from '../data/projects';

const landscape = animations2D.filter((p) => !p.vertical);
const tall = animations2D.find((p) => p.vertical);
---

<section id="animations" data-scene="animations" class="section" aria-labelledby="anim-title">

	<div class="container-x">
		<SectionTitle id="anim-title" eyebrow="Motion" title="2D Informative Animations" tag="2025 Projects" />

		<!-- Desktop: landscape videos stacked on the left, the tall card spanning both rows on the right
		     (0.63fr ≈ the width at which a 9:16 card matches two stacked 16:9 cards). -->
		<div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-[1fr_0.63fr] lg:grid-rows-2">
			{
				landscape.map((p, i) => (
					<div class="reveal" style={`--delay:${(i % 2) * 100}ms`}>
						<VideoCard project={p} />
					</div>
				))
			}
			{
				tall && (
					<div class="reveal mx-auto w-full max-w-xs sm:col-span-2 lg:col-span-1 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:max-w-none [--delay:200ms]">
						<VideoCard project={tall} class="lg:aspect-auto lg:h-full" />
					</div>
				)
			}
		</div>
	</div>
</section>

---
import { asset } from '../lib/asset';
import { socials } from '../data/site';
---

<footer class="relative pt-10 pb-28 sm:pb-10">
	<div class="container-x flex flex-col items-center justify-between gap-6 sm:flex-row">
		<a href="#top" class="flex items-center gap-3" aria-label="JED Creatives — back to top">
			<img src={asset('img/logo-white.png')} alt="" width="21" height="24" class="h-6 w-auto" />
			<span class="font-title text-xs font-semibold tracking-[0.2em]">JED CREATIVES</span>
		</a>
		<ul class="flex gap-2">
			{
				socials.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener" class="pill transition duration-300 hover:text-cyan">
							{s.label}
						</a>
					</li>
				))
			}
		</ul>
		<p class="text-xs text-white/60">© {new Date().getFullYear()} JED Creatives</p>
	</div>
</footer>

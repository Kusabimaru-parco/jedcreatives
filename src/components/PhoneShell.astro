---
// A CSS-rendered iPhone (titanium band, Dynamic Island, side buttons, glass reflection).
// Whatever is passed in fills the screen. All sizes are in cqw (1% of the phone's width),
// so the phone scales as one picture — set its width from outside.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['phone', className]}>
	<span class="btn-side action" aria-hidden="true"></span>
	<span class="btn-side vol-up" aria-hidden="true"></span>
	<span class="btn-side vol-down" aria-hidden="true"></span>
	<span class="btn-side power" aria-hidden="true"></span>

	<div class="phone-frame">
		<div class="phone-screen">
			<slot />
			<div class="phone-glare" aria-hidden="true"></div>
		</div>
		<span class="phone-island" aria-hidden="true"><i></i></span>
	</div>
</div>

<style>
	.phone {
		position: relative;
		container-type: inline-size;
		aspect-ratio: 71.6 / 146.6; /* iPhone 15 Pro proportions */
		filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.6));
	}
	/* Titanium band: brushed-metal gradient with a bright rim highlight. */
	.phone-frame {
		position: absolute;
		inset: 0;
		padding: 1.9cqw;
		border-radius: 16.5cqw;
		background: linear-gradient(140deg, #d9d6d1 0%, #8d8a86 14%, #4b4946 34%, #2c2b2a 52%, #6e6b67 74%, #c9c5bf 100%);
		box-shadow:
			inset 0 0 0 0.35cqw rgb(255 255 255 / 0.35),
			inset 0 0 1.2cqw rgb(0 0 0 / 0.6);
	}
	.btn-side {
		position: absolute;
		width: 1.3cqw;
		border-radius: 0.6cqw;
		background: linear-gradient(90deg, #3a3937, #a9a6a1 50%, #4b4946);
	}
	.btn-side.action,
	.btn-side.vol-up,
	.btn-side.vol-down {
		left: -0.9cqw;
	}
	.btn-side.action {
		top: 17%;
		height: 5.5%;
	}
	.btn-side.vol-up {
		top: 25%;
		height: 9.5%;
	}
	.btn-side.vol-down {
		top: 36.5%;
		height: 9.5%;
	}
	.btn-side.power {
		right: -0.9cqw;
		top: 28%;
		height: 15%;
	}
	/* Black bezel + screen */
	.phone-screen {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: 14.8cqw;
		background: #000;
		border: 2.4cqw solid #050505;
	}
	.phone-island {
		position: absolute;
		top: 5.2cqw;
		left: 50%;
		translate: -50% 0;
		width: 30cqw;
		height: 8.6cqw;
		border-radius: 999px;
		background: #000;
		z-index: 3;
	}
	.phone-island i {
		position: absolute;
		right: 3cqw;
		top: 50%;
		translate: 0 -50%;
		width: 3.4cqw;
		height: 3.4cqw;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #3a4a7a, #0b0f1e 60%);
	}
	.phone-glare {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(118deg, rgb(255 255 255 / 0.14) 0%, rgb(255 255 255 / 0.03) 28%, transparent 42%);
		pointer-events: none;
	}
</style>

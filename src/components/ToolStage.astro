---
// Decorative "app window" behind the About photo. It shows a CSS-built mock of whichever tool is selected
// in the floating tool orbit (Photoshop, Premiere Pro, After Effects, Krita, Blender).
//
// Everything inside is sized in --u = 1/640 of the window's width (container query units), so the whole
// UI scales as one picture at any screen size — nothing gets clipped or reflows.
// Switch apps by dispatching on the element:  stage.dispatchEvent(new CustomEvent('show', { detail: 'blender' }))
import { asset } from '../lib/asset';

interface Props {
	/** App shown initially (and without JS). */
	active?: string;
	class?: string;
}
const { active = 'premiere', class: className } = Astro.props;

const apps = [
	{ id: 'photoshop', name: 'Adobe Photoshop', file: 'poster_final.psd @ 66.7% (Title, RGB/8)', accent: '#31a8ff' },
	{ id: 'premiere', name: 'Adobe Premiere Pro', file: 'JED_Showreel — Sequence 01', accent: '#b38cff' },
	{ id: 'after-effects', name: 'Adobe After Effects', file: 'title_anim.aep — Comp 1', accent: '#7f8cff' },
	{ id: 'krita', name: 'Krita', file: 'character_sketch.kra', accent: '#ff5fa2' },
	{ id: 'blender', name: 'Blender', file: 'studio_set.blend', accent: '#ff8a1f' },
];
const accentOf = (id: string) => apps.find((a) => a.id === id)?.accent ?? '#3fb8ff';

const poster = (slug: string) => `url(${asset(`media/posters/${slug}.webp`)})`;

// Deterministic waveform for the Premiere audio tracks (same output every build).
const wave = (seed: number, n = 160) => {
	let x = seed;
	const rand = () => (x = (x * 9301 + 49297) % 233280) / 233280;
	return Array.from({ length: n }, (_, i) => {
		const h = Math.max(0.08, rand() * (0.35 + 0.65 * Math.abs(Math.sin(i / 9 + seed))));
		return `M${i * 2 + 0.5} ${10 - h * 9}V${10 + h * 9}`;
	}).join('');
};
const waveA = wave(3);
const waveB = wave(11);
---

<div
	class:list={['ts pointer-events-none select-none', className]}
	style={`--accent:${accentOf(active)}`}
	aria-hidden="true"
	data-tool-stage
>
	<div class="ts-window">
		<div class="ts-inner">
			<!-- Title bar -->
			<div class="ts-titlebar">
				<span class="ts-dots"><i></i><i></i><i></i></span>
				{
					apps.map((a) => (
						<span class:list={['ts-title', a.id === active && 'is-active']} data-app={a.id} data-accent={a.accent}>
							<b>{a.name}</b>
							<span> — {a.file}</span>
						</span>
					))
				}
			</div>

			<div class="ts-body">
				<!-- ================= PHOTOSHOP ================= -->
				<div class:list={['ts-app ps', active === 'photoshop' && 'is-active']} data-app="photoshop">
					<div class="bar ps-opts"><i style="--w:44"></i><i style="--w:24"></i><i style="--w:60"></i><i style="--w:30"></i><i style="--w:38"></i></div>
					<div class="toolbar">{Array.from({ length: 11 }, (_, i) => <i class:list={[i === 2 && 'on']}></i>)}</div>
					<div class="ps-canvas">
						<div class="ps-board">
							<div class="ps-glow"></div>
							<img src={asset('img/cutouts/portrait-sm.webp')} alt="" class="ps-photo" loading="lazy" decoding="async" />
							<div class="ps-type">JED</div>
							<div class="ps-sub">CREATIVES</div>
							<div class="ps-select">{Array.from({ length: 8 }, () => <i></i>)}</div>
						</div>
						<span class="t ps-zoom">66.67%</span>
					</div>
					<div class="side ps-layers">
						<div class="tabs"><span class="on">Layers</span><span>Channels</span><span>Paths</span></div>
						{
							['Title', 'Glow', 'Jameel', 'Shape 2', 'Gradient', 'Background'].map((n, i) => (
								<div class:list={['ps-row', i === 0 && 'on']}>
									<i class="eye"></i>
									<i class="thumb" style={`--c:${['#fff', '#3fb8ff', '#8a6a52', '#1e4dff', '#0a1a4a', '#02040f'][i]}`}></i>
									<span class="t">{n}</span>
								</div>
							))
						}
						<div class="ps-foot">{Array.from({ length: 6 }, () => <i></i>)}</div>
					</div>
				</div>

				<!-- ================= PREMIERE PRO ================= -->
				<div class:list={['ts-app pr', active === 'premiere' && 'is-active']} data-app="premiere">
					<div class="pr-bin">
						<span class="t head">Project: JED_Showreel</span>
						<div class="pr-grid">
							{
								['promovid', 'isdae-fv', 'alerto-24', 'lions-update'].map((s, i) => (
									<div class="pr-item">
										<i style={`--img:${poster(s)}`}></i>
										<span class="t">{['PROMO.mp4', 'ISDAE_FV.mp4', 'A24_OPEN.mov', 'LIONS.mov'][i]}</span>
									</div>
								))
							}
						</div>
					</div>
					<div class="pr-monitor">
						<span class="t head">Program: Sequence 01</span>
						<div class="pr-frame" style={`--img:${poster('promovid')}`}></div>
						<span class="t pr-tc">00:00:27:14</span>
						<div class="pr-ctrl">{Array.from({ length: 5 }, (_, i) => <i class:list={[i === 2 && 'play']}></i>)}</div>
					</div>
					<div class="pr-tl">
						<div class="pr-ruler"><span class="t" style="--x:60">00:00:20:00</span><span class="t" style="--x:240">00:00:25:00</span><span class="t" style="--x:420">00:00:30:00</span></div>
						<div class="pr-work"></div>
						<div class="trk"><b class="t">V2</b><div class="lane">
							<span class="clip fx" style="--x:90;--w:130"></span><span class="clip fx" style="--x:420;--w:80"></span>
						</div></div>
						<div class="trk"><b class="t">V1</b><div class="lane">
							<span class="clip v" style="--x:0;--w:150"><em>C0405</em></span>
							<span class="clip v" style="--x:154;--w:120"><em>MVI_8</em></span>
							<span class="clip v" style="--x:278;--w:170"><em>C0405.MP4</em></span>
							<span class="clip v" style="--x:452;--w:150"><em>MVI_92</em></span>
						</div></div>
						<div class="trk tall"><b class="t">V0</b><div class="lane">
							{
								[[0, 140, 'isdae-gfx'], [144, 110, 'isdae-fv'], [258, 170, 'promovid'], [432, 170, 'alerto-24']].map(([x, w, s]) => (
									<span class="clip th" style={`--x:${x};--w:${w};--img:${poster(s as string)}`}></span>
								))
							}
						</div></div>
						<div class="trk"><b class="t">A1</b><div class="lane">
							<span class="clip a" style="--x:0;--w:448"><svg viewBox="0 0 320 20" preserveAspectRatio="none"><path d={waveA}></path></svg></span>
							<span class="clip a" style="--x:452;--w:150"><svg viewBox="0 0 320 20" preserveAspectRatio="none"><path d={waveB}></path></svg></span>
						</div></div>
						<div class="trk"><b class="t">A2</b><div class="lane">
							<span class="clip a a2" style="--x:90;--w:510"><svg viewBox="0 0 320 20" preserveAspectRatio="none"><path d={waveB}></path></svg></span>
						</div></div>
						<div class="playhead"><i></i></div>
					</div>
				</div>

				<!-- ================= AFTER EFFECTS ================= -->
				<div class:list={['ts-app ae', active === 'after-effects' && 'is-active']} data-app="after-effects">
					<div class="ae-view">
						<span class="t head">Composition: Title_Anim</span>
						<div class="ae-comp">
							<div class="ae-safe"></div>
							<div class="ae-path"></div>
							<i class="ae-key" style="--x:53;--y:133"></i><i class="ae-key" style="--x:163;--y:53"></i><i class="ae-key" style="--x:273;--y:133"></i>
							<div class="ae-mx"><div class="ae-my"><div class="ae-dot"></div></div></div>
							<div class="ae-word">MOTION</div>
						</div>
					</div>
					<div class="ae-tl">
						<div class="ae-names">
							<div class="ae-hrow t"><span>#</span><span>Layer Name</span></div>
							{
								[
									['1', 'Title', '#e8c33c'],
									['2', 'Shape Layer 1', '#7f8cff'],
									['', 'Position', ''],
									['3', 'Null 1', '#d65a5a'],
									['4', 'BG Solid', '#5ab36b'],
								].map(([n, name, c]) => (
									<div class:list={['ae-row t', !n && 'prop']}>
										<span>{n}</span>
										{c ? <i style={`--c:${c}`}></i> : <i class="none"></i>}
										<span>{name}</span>
									</div>
								))
							}
						</div>
						<div class="ae-lanes">
							<div class="ae-ruler t">{['0s', '1s', '2s', '3s', '4s'].map((s, i) => <span style={`--x:${i * 100}`}>{s}</span>)}</div>
							<div class="ae-lane"><span class="bar" style="--x:0;--w:430;--c:#e8c33c"></span><b class="kf" style="--x:40"></b><b class="kf" style="--x:120"></b></div>
							<div class="ae-lane"><span class="bar" style="--x:20;--w:400;--c:#7f8cff"></span></div>
							<div class="ae-lane prop"><b class="kf on" style="--x:20"></b><b class="kf on" style="--x:220"></b><b class="kf on" style="--x:420"></b><svg viewBox="0 0 400 20" preserveAspectRatio="none" class="ae-graph"><path d="M0 18 C 80 18, 120 2, 200 2 S 320 18, 400 18"></path></svg></div>
							<div class="ae-lane"><span class="bar" style="--x:0;--w:430;--c:#d65a5a"></span></div>
							<div class="ae-lane"><span class="bar" style="--x:0;--w:430;--c:#5ab36b"></span></div>
							<div class="playhead"><i></i></div>
						</div>
					</div>
				</div>

				<!-- ================= KRITA ================= -->
				<div class:list={['ts-app kr', active === 'krita' && 'is-active']} data-app="krita">
					<div class="bar kr-top"><i style="--w:40"></i><i style="--w:56"></i><i style="--w:32"></i><i style="--w:48"></i></div>
					<div class="toolbar">{Array.from({ length: 11 }, (_, i) => <i class:list={[i === 0 && 'on']}></i>)}</div>
					<div class="kr-canvas">
						<div class="kr-paper">
							<div class="kr-wash"></div>
							<svg viewBox="0 0 410 318" class="kr-art">
								<path class="ink" d="M70 250 C 110 150, 170 120, 205 165 S 280 255, 335 140"></path>
								<path class="ink thin" d="M95 90 C 140 60, 200 70, 240 95"></path>
								<path class="ink pink" d="M150 205 C 180 230, 230 232, 262 205"></path>
								<path class="stroke" d="M60 120 C 120 40, 230 40, 260 110 S 330 230, 370 200"></path>
							</svg>
						</div>
					</div>
					<div class="side kr-dock">
						<span class="t head">Advanced Color Selector</span>
						<div class="kr-wheel"><div class="kr-ring"></div><div class="kr-square"></div><i class="kr-pick"></i></div>
						<span class="t head">Brush Presets</span>
						<div class="kr-brushes">{Array.from({ length: 12 }, (_, i) => <i class:list={[i === 5 && 'on']} style={`--h:${[20, 45, 70, 95, 30, 60, 85, 15, 50, 75, 40, 90][i]}%`}></i>)}</div>
						<div class="kr-slider t"><span>Size</span><i style="--v:38%"></i><span>24 px</span></div>
						<div class="kr-slider t"><span>Opacity</span><i style="--v:100%"></i><span>100%</span></div>
					</div>
				</div>

				<!-- ================= BLENDER ================= -->
				<div class:list={['ts-app bl', active === 'blender' && 'is-active']} data-app="blender">
					<div class="bar bl-head"><span class="t bl-mode">Object Mode</span><span class="t">View</span><span class="t">Select</span><span class="t">Add</span><span class="t">Object</span></div>
					<div class="bl-view">
						<span class="t bl-label">User Perspective<br />(1) Collection | Cube</span>
						<div class="bl-floor"><i class="ax x"></i><i class="ax y"></i></div>
						<div class="bl-scene">
							<div class="bl-cube">
								<i class="f front"></i><i class="f back"></i><i class="f right"></i><i class="f left"></i><i class="f top"></i><i class="f bottom"></i>
							</div>
						</div>
						<div class="bl-gizmo"><i class="g x"><b>X</b></i><i class="g y"><b>Y</b></i><i class="g z"><b>Z</b></i></div>
					</div>
					<div class="side bl-out">
						{
							[
								['Scene Collection', 0, ''],
								['Collection', 1, ''],
								['Camera', 2, 'cam'],
								['Cube', 2, 'mesh'],
								['Light', 2, 'light'],
							].map(([n, d, k]) => (
								<div class:list={['bl-orow t', n === 'Cube' && 'on']} style={`--d:${d}`}>
									<i class={k as string}></i>
									{n}
								</div>
							))
						}
					</div>
					<div class="side bl-props">
						<div class="bl-tabs">{Array.from({ length: 8 }, (_, i) => <i class:list={[i === 3 && 'on']}></i>)}</div>
						<div class="bl-fields">
							{['Location X', 'Y', 'Z', 'Rotation X', 'Y', 'Z', 'Scale X'].map((n, i) => (
								<div class="bl-field t"><span>{n}</span><i>{['0 m', '0 m', '1 m', '0°', '0°', '45°', '1.000'][i]}</i></div>
							))}
						</div>
					</div>
					<div class="bl-time">
						<div class="bl-nums t">{[0, 20, 40, 60, 80, 100, 120].map((n, i) => <span style={`--x:${i * 70}`}>{n}</span>)}</div>
						<div class="bl-keys">{[30, 120, 260, 330].map((x) => <b style={`--x:${x}`}></b>)}</div>
						<div class="playhead"><i></i></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* ---------- Window ---------- */
	/* Feathered on every edge so the window melts into the background like a thought. */
	.ts {
		perspective: 1400px;
		--feather-x: linear-gradient(to right, transparent 0%, #000 7%, #000 93%, transparent 100%);
		--feather-y: linear-gradient(to bottom, transparent 0%, #000 6%, #000 84%, transparent 100%);
		-webkit-mask-image: var(--feather-x), var(--feather-y);
		-webkit-mask-composite: source-in;
		mask-image: var(--feather-x), var(--feather-y);
		mask-composite: intersect;
	}
	.ts-window {
		container-type: inline-size;
		aspect-ratio: 640 / 386;
		border-radius: 18px;
		overflow: hidden;
		background: linear-gradient(180deg, rgb(10 18 54 / 0.9), rgb(5 10 34 / 0.9));
		border: 1px solid rgb(255 255 255 / 0.08);
		box-shadow:
			0 30px 70px -34px rgb(0 0 0 / 0.75),
			0 0 90px -30px var(--accent);
		transform: rotateY(calc(-6deg + var(--mx, 0) * 2deg)) rotateX(calc(3deg - var(--my, 0) * 1.5deg));
		transition:
			transform 1.2s var(--ease-soft),
			box-shadow 1s var(--ease-soft);
	}
	.ts-inner {
		--u: calc(100cqw / 640);
		position: relative;
		height: 100%;
		font-size: calc(var(--u) * 8);
		line-height: 1.2;
		color: rgb(255 255 255 / 0.6);
	}
	.ts-inner :global(*) {
		box-sizing: border-box;
	}
	.t {
		font-size: calc(var(--u) * 7.5);
		color: rgb(255 255 255 / 0.55);
		white-space: nowrap;
	}
	.head {
		display: block;
		padding: calc(var(--u) * 4) calc(var(--u) * 6);
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.ts-titlebar {
		position: relative;
		height: calc(var(--u) * 24);
		display: flex;
		align-items: center;
		gap: calc(var(--u) * 10);
		padding-inline: calc(var(--u) * 10);
		background: rgb(255 255 255 / 0.04);
		border-bottom: 1px solid rgb(255 255 255 / 0.07);
		box-shadow: inset 0 calc(var(--u) * 2) 0 var(--accent);
		transition: box-shadow 0.6s var(--ease-soft);
	}
	.ts-dots {
		display: flex;
		gap: calc(var(--u) * 4);
	}
	.ts-dots i {
		width: calc(var(--u) * 7);
		height: calc(var(--u) * 7);
		border-radius: 50%;
		background: rgb(255 255 255 / 0.18);
	}
	.ts-title {
		position: absolute;
		left: calc(var(--u) * 46);
		font-size: calc(var(--u) * 8.5);
		white-space: nowrap;
		color: rgb(255 255 255 / 0.5);
		opacity: 0;
		transition: opacity 0.9s var(--ease-soft);
	}
	.ts-title b {
		color: #fff;
		font-weight: 600;
	}
	.ts-title.is-active {
		opacity: 1;
	}

	.ts-body {
		position: relative;
		height: calc(var(--u) * 362);
	}
	/* App switch: cross-fade with a slight settle. Inactive apps pause their animations. */
	/* Smooth switch: the old app blurs out while the new one comes into focus. */
	.ts-app {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		scale: 0.98;
		filter: blur(6px);
		transition:
			opacity 0.9s var(--ease-soft),
			scale 0.9s var(--ease-soft),
			filter 0.9s var(--ease-soft),
			visibility 0s linear 0.9s;
	}
	.ts-app.is-active {
		opacity: 1;
		visibility: visible;
		scale: 1;
		filter: none;
		transition-delay: 0s;
	}
	.ts-app:not(.is-active) :global(*),
	.ts:not(.is-live) :global(*) {
		animation-play-state: paused !important;
	}

	/* ---------- Shared bits ---------- */
	.bar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: calc(var(--u) * 16);
		display: flex;
		align-items: center;
		gap: calc(var(--u) * 6);
		padding-left: calc(var(--u) * 34);
		background: rgb(255 255 255 / 0.035);
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}
	.bar i {
		width: calc(var(--u) * var(--w));
		height: calc(var(--u) * 7);
		border-radius: calc(var(--u) * 2);
		background: rgb(255 255 255 / 0.1);
	}
	.toolbar {
		position: absolute;
		left: 0;
		top: calc(var(--u) * 16);
		bottom: 0;
		width: calc(var(--u) * 26);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--u) * 7);
		padding-top: calc(var(--u) * 8);
		background: rgb(255 255 255 / 0.03);
		border-right: 1px solid rgb(255 255 255 / 0.06);
	}
	.toolbar i {
		width: calc(var(--u) * 12);
		height: calc(var(--u) * 12);
		border-radius: calc(var(--u) * 3);
		background: rgb(255 255 255 / 0.12);
	}
	.toolbar i.on {
		background: var(--accent);
		box-shadow: 0 0 calc(var(--u) * 6) var(--accent);
	}
	.side {
		position: absolute;
		right: 0;
		width: calc(var(--u) * 172);
		background: rgb(255 255 255 / 0.04);
		border-left: 1px solid rgb(255 255 255 / 0.07);
	}
	.playhead {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: calc(var(--u) * 1.5);
		background: var(--ph, #3fb8ff);
		box-shadow: 0 0 calc(var(--u) * 6) var(--ph, #3fb8ff);
		animation: scrub var(--dur, 14s) linear infinite;
	}
	.playhead i {
		position: absolute;
		top: 0;
		left: 50%;
		translate: -50% 0;
		width: calc(var(--u) * 9);
		height: calc(var(--u) * 10);
		border-radius: calc(var(--u) * 2) calc(var(--u) * 2) calc(var(--u) * 5) calc(var(--u) * 5);
		background: var(--ph, #3fb8ff);
	}
	@keyframes scrub {
		from {
			translate: calc(var(--u) * var(--from, 0)) 0;
		}
		to {
			translate: calc(var(--u) * var(--to, 600)) 0;
		}
	}

	/* ---------- Photoshop ---------- */
	.ps-canvas {
		position: absolute;
		left: calc(var(--u) * 26);
		right: calc(var(--u) * 172);
		top: calc(var(--u) * 16);
		bottom: 0;
		background:
			radial-gradient(circle at 50% 50%, rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.35)),
			rgb(0 0 0 / 0.2);
	}
	.ps-board {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		width: calc(var(--u) * 176);
		height: calc(var(--u) * 246);
		overflow: hidden;
		border-radius: calc(var(--u) * 2);
		background: linear-gradient(165deg, #050b2a 0%, #0a1a4a 35%, #1e4dff 75%, #3fb8ff 100%);
		box-shadow: 0 calc(var(--u) * 10) calc(var(--u) * 30) rgb(0 0 0 / 0.5);
	}
	.ps-glow {
		position: absolute;
		inset: 30% -20% -10%;
		background: radial-gradient(closest-side, rgb(63 184 255 / 0.7), transparent);
	}
	.ps-photo {
		position: absolute;
		bottom: 0;
		left: 50%;
		translate: -50% 0;
		height: 74%;
		width: auto;
		max-width: none;
	}
	.ps-type {
		position: absolute;
		top: calc(var(--u) * 12);
		inset-inline: 0;
		text-align: center;
		font-family: var(--font-display);
		font-size: calc(var(--u) * 68);
		line-height: 0.9;
		color: #fff;

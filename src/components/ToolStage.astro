<script>
	for (const stage of document.querySelectorAll<HTMLElement>('[data-tool-stage]')) {
		const parts = [...stage.querySelectorAll<HTMLElement>('[data-app]')];

		stage.addEventListener('show', (e) => {
			const id = (e as CustomEvent<string>).detail;
			const title = parts.find((p) => p.dataset.app === id && p.dataset.accent);
			if (!title) return;
			for (const p of parts) p.classList.toggle('is-active', p.dataset.app === id);
			stage.style.setProperty('--accent', title.dataset.accent!);
		});

		// Only animate while the window is on screen.
		new IntersectionObserver(([entry]) => stage.classList.toggle('is-live', entry.isIntersecting)).observe(stage);
	}
</script>

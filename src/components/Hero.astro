---
import HeroVideos from './HeroVideos.astro';
import { asset } from '../lib/asset';
import { heroTags, site } from '../data/site';

// Where each floating tag sits around the photo (mobile / desktop).
const tagPositions = [
	'left-[4%] top-[47%] sm:left-[15%] sm:top-[56%]',
	// Video Editing: moved above the face on phones; tablet/desktop keep their wordmark-aware position.
	'right-[4%] top-[48%] sm:right-[15%] sm:top-[max(57%,calc(19%+13.5vw+4.5rem))]',
	'left-[5%] top-[66%] sm:left-[21%] sm:top-[72%]',
	'right-[6%] top-[73%] sm:right-[22%] sm:top-[69%]',
];
// 3D: each tag turns in toward the photo (left side +, right side −) and gets its own parallax depth.
const tagTilts = [22, -22, 18, -18];
const tagDepths = [18, 22, 26, 14];
---

<section id="top" data-scene="hero" class="relative isolate flex min-h-[max(100svh,600px)] flex-col overflow-hidden">

	<!-- Everything except the background lives in this stage, so it can recede in 3D as you scroll to About
	     while the background stays put (keeps the hero → About colour blend seamless). -->
	<div class="hero-stage absolute inset-0 flex flex-col" data-hero-stage>

	<!-- Wordmark (behind the photo). Outer = mouse parallax + tilt, inner = slow 3D float. -->
	<div class="hero-3d pointer-events-none absolute inset-x-0 top-[12%] z-10 text-center sm:top-[19%]" style="--depth:6; --tilt:1.5">
		<div class="hero-float" style="--float:12s; --float-y:-3px; --float-rx:0.8deg">
		<p class="eyebrow mb-3 text-[0.625rem] tracking-[0.2em] text-white/70 sm:mb-5 sm:text-xs sm:tracking-[0.25em]">
			{site.name} · {site.role}<span class="hidden sm:inline"> </span>
		</p>
		<h1
			class="font-display text-[17.4vw] leading-[0.82] tracking-[-0.01em] whitespace-nowrap text-white uppercase [font-kerning:none] sm:text-[16.5vw]"
		>
			<span aria-hidden="true">JEDCREATIVES</span>
			<span class="sr-only">JED Creatives — {site.name}, {site.role}</span>
		</h1>
		</div>
	</div>

	<!-- Cutout photo (in front of the wordmark, nearer the viewer → moves more). Same layers as the wordmark. -->
	<div class="hero-3d hero-3d-photo pointer-events-none absolute inset-0 z-20" style="--depth:12; --tilt:2">
		<div class="hero-float absolute inset-0" style="--float:10s; --float-y:-4px; --float-rx:0.5deg; --float-delay:-2s">
	<img
		src={asset('img/cutouts/hero-camera-lg.webp')}
		srcset={`${asset('img/cutouts/hero-camera-sm.webp')} 480w, ${asset('img/cutouts/hero-camera-lg.webp')} 702w`}
		sizes="(max-width: 640px) 380px, 600px"
		width="702"
		height="896"
		alt={`${site.name} in a brown leather jacket, raising a camera to take a photo`}
		fetchpriority="high"
		decoding="async"
		class="hero-photo pointer-events-none absolute bottom-0 left-1/2 h-[60svh] w-auto max-w-none -translate-x-1/2 select-none sm:h-[72svh] sm:max-h-[57.5rem]"
	/>
		</div>
	</div>

	<!-- Floating glass tags -->
	<ul class="pointer-events-none absolute inset-0 z-30" aria-label="What I do">
		{
			heroTags.map((tag, i) => (
				<li class={`tag-stage absolute ${tagPositions[i]}`} style={`--tilt-y:${tagTilts[i]}deg; --depth:${tagDepths[i]}; --in-delay:${450 + i * 120}ms`}>
					<span class="tag-3d inline-block">
						<span class="pill hero-tag float hero-in" style={`--delay:${450 + i * 120}ms; --float-delay:${i * -1.6}s`}>
							<span class="hero-tag-dot rounded-full bg-cyan shadow-[0_0_8px_var(--color-cyan)]" aria-hidden="true" />
							{tag}
						</span>
					</span>
				</li>
			))
		}
	</ul>

	<!-- Scroll hint → About ("Get a project?" lives in the nav) -->
	<div class="pointer-events-none relative z-30 mt-auto flex justify-center px-4 pb-6 max-sm:hidden sm:pb-9">
		<a href="#about" class="scroll-hint hero-in pointer-events-auto flex flex-col items-center gap-2.5 rounded-full px-3 py-2 [--delay:900ms]">
			<span class="scroll-mouse" aria-hidden="true"><span></span></span>
			<span class="text-[0.625rem] font-medium tracking-[0.3em] text-white/75 uppercase">Scroll to About me</span>
		</a>
	</div>

	<!-- Floating project videos (after the scroll hint in tab order; layered behind the wordmark until focused) -->
	<HeroVideos />
	</div>
</section>

<style>
	.hero-photo {
		/* Fade only the bottom (where the mid-shot is cut) into the background; the sides stay solid. */
		-webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
		animation: photo-in 1.4s var(--ease-soft) 0.15s both;
	}

	.hero-in {
		animation: rise 0.9s var(--ease-soft) both;
		animation-delay: var(--delay, 0ms);
	}

	.float {
		animation:
			rise 0.9s var(--ease-soft) var(--delay, 0ms) both,
			float 7s ease-in-out var(--float-delay, 0s) infinite;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
	/* Photo rises in and brightens to full as the intro hands off. */
	@keyframes photo-in {
		from {
			opacity: 0;
			transform: translateY(40px) scale(0.96);
			filter: brightness(0.6) blur(1.5px);
		}
	}
	@keyframes float {
		50% {
			translate: 0 -7px;
			rotate: x 14deg;
		}
	}

	/* Scroll exit: the stage tilts back from its bottom edge while it recedes (driven by the script below). */
	.hero-stage {
		transform-origin: 50% 100%;
		will-change: transform, opacity, filter;
	}

	/* Scroll hint: a small mouse with a wheel dot that rolls down, plus a label. */
	.scroll-mouse {
		position: relative;
		width: 22px;
		height: 34px;
		border-radius: 999px;
		border: 1.5px solid rgb(255 255 255 / 0.6);
		box-shadow: 0 0 18px -4px rgb(63 184 255 / 0.6);
		transition: border-color 0.3s;
	}
	.scroll-mouse span {
		position: absolute;
		left: 50%;
		top: 7px;
		width: 3px;
		height: 7px;
		margin-left: -1.5px;
		border-radius: 2px;
		background: #fff;
		animation: wheel 1.8s var(--ease-soft) infinite;
	}
	@keyframes wheel {
		0% {
			translate: 0 0;
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		80%,
		100% {
			translate: 0 11px;
			opacity: 0;
		}
	}
	.scroll-hint:hover .scroll-mouse,
	.scroll-hint:focus-visible .scroll-mouse {
		border-color: #fff;
	}
	.scroll-hint:hover span:last-child,
	.scroll-hint:focus-visible span:last-child {
		color: #fff;
	}

	/* 3D wordmark + photo: follow the mouse (--mx/--my, -1…1, set by the script below) with their own depth
	   and tilt, and bob slowly in 3D — deliberately subtle (a few px / ~2°) so they stay calm next to the cards. At rest everything is at identity, so the
	   intro's wordmark still lines up exactly with the hero title at the handoff. */
	.hero-3d {
		transform: perspective(1400px)
			translate3d(calc(var(--mx, 0) * var(--depth) * 1px), calc(var(--my, 0) * var(--depth) * 1px), 0)
			rotateY(calc(var(--mx, 0) * var(--tilt) * 1deg)) rotateX(calc(var(--my, 0) * var(--tilt) * -1deg));
		transition: transform 0.7s var(--ease-soft);
	}
	.hero-3d-photo {
		transform-origin: 50% 100%; /* pivots from where he stands */
	}
	.hero-float {
		transform-style: preserve-3d;
		animation: hero-float var(--float, 10s) ease-in-out var(--float-delay, 0s) infinite;
	}
	@keyframes hero-float {
		0%,
		100% {
			transform: perspective(1400px) translate3d(0, 0, 0) rotateX(0deg);
		}
		50% {
			transform: perspective(1400px) translate3d(0, var(--float-y), 0) rotateX(var(--float-rx));
		}
	}

	/* 3D tags: perspective per tag, resting turn toward the photo, plus mouse parallax
	   (--mx/--my, -1…1, set on the section by the script below). The background stays flat. */
	.tag-stage {
		perspective: 600px;
	}
	.tag-3d {
		transform-style: preserve-3d;
		transform: translate3d(calc(var(--mx, 0) * var(--depth) * 1px), calc(var(--my, 0) * var(--depth) * 1px), 0)
			rotateY(calc(var(--tilt-y) + var(--mx, 0) * 12deg)) rotateX(calc(var(--my, 0) * -12deg));
		transition: transform 0.6s var(--ease-soft);
	}
	/* Entrance: each tag swings in from depth to its resting angle. */
	.tag-3d {
		animation: tag-in 1.1s var(--ease-soft) var(--in-delay, 0ms) backwards;
	}
	@keyframes tag-in {
		from {
			transform: translate3d(0, 30px, -180px) rotateY(calc(var(--tilt-y) * 3)) rotateX(40deg);
		}
	}
	/* Skill tags scale with the screen width like the JEDCREATIVES wordmark, so they keep the same proportion
	   when the page is zoomed in or out. Padding, gap and dot are in em, so the whole pill scales together. */
	.hero-tag {
		font-size: max(12px, 1vw);
		gap: 0.6em;
		padding: 0.55em 1.15em;
	}
	.hero-tag-dot {
		width: 0.5em;
		height: 0.5em;
	}
	.tag-3d .pill {
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.12),
			0 10px 24px -10px rgb(0 0 0 / 0.6),
			0 0 28px -8px rgb(63 184 255 / 0.45);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-photo,
		.hero-in,
		.float {
			animation: none;
		}
		.tag-3d {
			transition: none;
			animation: none;
		}
		.hero-3d {
			transition: none;
		}
		.scroll-mouse span {
			animation: none;
			opacity: 1;
		}
		.hero-float {
			animation: none;
		}
	}
</style>

<script>
	// Scroll exit: as you scroll toward About, the hero content tilts back from its bottom edge, recedes and
	// fades into the blue. The background stays, so the colour blend into About remains seamless.
	{
		const hero = document.getElementById('top');
		const stage = hero?.querySelector<HTMLElement>('[data-hero-stage]');
		if (hero && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			let frame = 0;
			const update = () => {
				frame = 0;
				const clamp = (v: number) => Math.min(1, Math.max(0, v));
				const smooth = (v: number) => v * v * (3 - 2 * v);
				const p = clamp(window.scrollY / (hero.offsetHeight * 0.8));
				// Shade over the hero→About seam (read by HeroBackground + About), so the bright band calms down.
				document.documentElement.style.setProperty('--hero-exit', smooth(p).toFixed(3));
				if (p < 0.001) {
					stage.style.transform = '';
					stage.style.opacity = '';
					stage.style.filter = '';
					return;
				}
				const e = smooth(p);
				// Fully dissolved by 65% of the way, so it never lingers as a see-through ghost.
				const fade = smooth(clamp(p / 0.65));
				stage.style.transform = `perspective(1200px) translate3d(0, ${(-e * 50).toFixed(1)}px, ${(-e * 280).toFixed(1)}px) rotateX(${(e * 12).toFixed(2)}deg)`;
				stage.style.opacity = (1 - fade).toFixed(3);
				stage.style.filter = `blur(${(fade * 8).toFixed(1)}px)`;
			};
			addEventListener('scroll', () => frame || (frame = requestAnimationFrame(update)), { passive: true });
			update();
		}
	}

	// Mouse parallax for the floating 3D layer (wordmark, photo, tags + video cards). Mouse/trackpad only; off for reduced motion.
	const hero = document.getElementById('top');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (hero && finePointer && !reduceMotion) {
		let frame = 0;
		let x = 0;
		let y = 0;
		const apply = () => {
			frame = 0;
			hero.style.setProperty('--mx', x.toFixed(3));
			hero.style.setProperty('--my', y.toFixed(3));
		};
		// Listen on the whole document (the fixed nav sits over the hero and would otherwise count as
		// "leaving" it); only react while the pointer is within the hero's box, ease back to rest outside it.
		document.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return;
			const r = hero.getBoundingClientRect();
			const inside = e.clientY >= r.top && e.clientY <= r.bottom;
			x = inside ? Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1)) : 0;
			y = inside ? Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1)) : 0;
			if (!frame) frame = requestAnimationFrame(apply);
		});
		document.documentElement.addEventListener('pointerleave', () => {
			x = 0;
			y = 0;
			if (!frame) frame = requestAnimationFrame(apply);
		});
	}
</script>

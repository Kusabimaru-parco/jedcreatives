---
// Services & pricing, centred: a "PRICING" title over a frosted-glass panel with two views (the price table,
// and Basic vs Pro) switched by arrows/dots/swipe with a 3D turn; then "PACKAGES" with the three monthly plans.
// Content: `pricing` and `packages` in src/data/site.ts. Big titles use the Epic Pro font (see Layout.astro).
import SplitWords from './SplitWords.astro';
import { packages, pricing } from '../data/site';

const { rows, tiers } = pricing;
const views = ['Prices', 'Basic vs Pro'];
---

<section id="services" data-scene="services" class="section overflow-hidden" aria-labelledby="services-title">
	<!-- Rises in from depth as About recedes, and recedes as Work comes up (see [data-depth] in Layout.astro). -->
	<div class="container-x" data-depth="in out">
		<p class="reveal eyebrow mb-4 sm:mb-6">JEDCREATIVES</p>

		<div class="pricing relative" data-tier="none">
			<h2 id="services-title" class="pricing-word reveal-title" data-fit>
				<span aria-hidden="true"><SplitWords text="Pricing" /></span>
				<span class="sr-only">Services and pricing</span>
			</h2>

			<div
				class="pricing-carousel reveal relative [--delay:120ms]"
				role="region"
				aria-roledescription="carousel"
				aria-label="Services and pricing"
				data-pricing
			>
				<div class="panes">
					<!-- View 1: price table -->
					<div class="pane is-active" role="group" aria-roledescription="slide" aria-label={`1 of 2: ${views[0]}`} data-pane>
						<div class="glass-panel table-panel relative overflow-hidden p-3 sm:p-6" data-table-panel data-spot>
							<span class="spot" aria-hidden="true"></span>
							<span class="col-bg col-basic" aria-hidden="true"></span>
							<span class="col-bg col-pro" aria-hidden="true"></span>
							<table class="price-table relative w-full">
								<colgroup>
									<col class="w-[11%]" /><col class="w-[37%]" /><col class="w-[24%]" /><col class="w-[28%]" />
								</colgroup>
								<thead>
									<tr>
										<th colspan="2" scope="col" class="font-title text-[0.625rem] tracking-[0.18em] text-white uppercase sm:text-sm">Services</th>
										<th scope="col"><span class="tier-pill">Basic</span></th>
										<th scope="col"><span class="tier-pill is-pro">Pro</span></th>
									</tr>
								</thead>
								<tbody>
									{
										rows.map((r, i) => (
											<tr>
												<td class="num">#{i + 1}</td>
												<th scope="row" class="svc">
													{r.service}
													{r.note && <span class="block">{r.note}</span>}
												</th>
												<td class="price">{r.basic}</td>
												<td class="price is-pro">{r.pro}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>

					<!-- View 2: Basic vs Pro -->
					<div class="pane" role="group" aria-roledescription="slide" aria-label={`2 of 2: ${views[1]}`} data-pane inert>
						<div class="tier-grid grid h-full gap-3 sm:grid-cols-[0.82fr_1fr] sm:gap-4">
							<article class="tier tier-basic glass-panel" data-tier-zone="basic">
								<span class="tier-pill">{tiers.basic.name}</span>
								<h3 class="tier-title">{tiers.basic.title}</h3>
								<ul class="tier-points">
									{tiers.basic.points.map((p) => <li>{p}</li>)}
								</ul>
								<p class="best">{tiers.basic.bestFor}</p>
							</article>
							<article class="tier tier-pro" data-tier-zone="pro">
								<span class="tier-pill is-pro">Pro</span>
								<h3 class="tier-title">{tiers.pro.title}</h3>
								<ul class="tier-points is-checked">
									{tiers.pro.points.map((p) => <li>{p}</li>)}
								</ul>
								<p class="best">{tiers.pro.bestFor}</p>
							</article>
						</div>
					</div>
				</div>

				<!-- Controls: arrows sit on the panel's sides from tablet up, and beside the dots on phones. -->
				<div class="mt-5 flex items-center justify-center gap-2">
					<button type="button" class="pricing-arrow is-prev" aria-label="Previous view" data-prev>
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</button>
					{
						views.map((v, i) => (
							<button type="button" class="pricing-dot" aria-label={`Show ${v}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i} />
						))
					}
					<button type="button" class="pricing-arrow is-next" aria-label="Next view" data-next>
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</button>
				</div>
				<p class="mt-4 text-center text-[0.6875rem] text-white/55">
					Prices in {pricing.currency} · “+” means starting price — the final quote depends on the project.
				</p>
			</div>
		</div>

		<!-- Monthly packages -->
		<div class="packages mt-24 sm:mt-32" aria-labelledby="packages-title">
			<h2 id="packages-title" class="pricing-word reveal-title" data-fit>
				<span><SplitWords text="Packages" /></span>
			</h2>
			<div class="pkg-grid">
				{
					packages.map((pk, i) => (
						<article class:list={['pkg reveal', `pkg-${pk.name.toLowerCase()}`]} style={`--delay:${i * 120}ms`} data-spot>
							<span class="spot" aria-hidden="true"></span>
							{/* Edge highlight: lights the border where the pointer is (see "Edge highlight" styles) */}
							<span class="edge" aria-hidden="true" />
							<span class="pkg-pill">{pk.name}</span>
							<p class="pkg-price">
								<span class="pkg-amount">{pk.price}</span>
								<span class="pkg-period">{pk.period}</span>
							</p>
							<ul class="pkg-features">
								{pk.features.map((f, j) => (
									<li style={`--j:${j}`}>{f}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* ---------- Layout: everything centred ---------- */
	.pricing,
	.packages {
		max-width: 56rem;
		margin-inline: auto;
	}
	.pricing-word {
		position: relative;
		font-family: var(--font-epic);
		font-weight: 800;
		/* Start size; the script below then fits each title exactly to the column width. */
		font-size: clamp(3rem, 11vw, 9rem);
		line-height: 0.85;
		text-transform: uppercase;
		text-align: center;
		white-space: nowrap;
		color: #fff;
	}
	/* The title sits fully above the panel (nothing covers it). */
	.pricing-carousel {
		z-index: 2;
		margin-top: clamp(1rem, 2.2vw, 1.75rem);
	}

	/* ---------- Packages ---------- */
	.packages {
		max-width: 72rem;
	}
	.pkg-grid {
		display: grid;
		gap: 1rem;
		margin-top: clamp(1.25rem, 2.5vw, 2rem);
		padding: 0.9rem;
		border-radius: 30px;
		background: rgb(255 255 255 / 0.04);
		border: 1px solid rgb(255 255 255 / 0.14);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.12),
			0 40px 90px -40px rgb(0 0 0 / 0.8);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
	}
	@media (min-width: 52rem) {
		.pkg-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.1rem;
			padding: 1.1rem;
		}
	}
	.pkg {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		padding: 1.6rem 1.5rem 1.8rem;
		border-radius: 22px;
		transition:
			opacity 0.8s var(--ease-soft) var(--delay, 0ms),
			transform 0.8s var(--ease-soft) var(--delay, 0ms),
			translate 0.5s var(--ease-soft),
			scale 0.5s var(--ease-soft),
			border-color 0.4s,
			box-shadow 0.5s var(--ease-soft);
	}
	.pkg > :not(.spot, .edge) {
		position: relative;
		z-index: 2;
	}

	/* ---------- Hover: shared polish ---------- */
	/* A soft light that follows the pointer across the panel / card (--sx/--sy set by the script). */
	.spot {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
		background: radial-gradient(260px circle at var(--sx, 50%) var(--sy, 0%), rgb(255 255 255 / 0.14), transparent 70%);
		opacity: 0;
		transition: opacity 0.4s;
		pointer-events: none;
	}
	@media (hover: hover) {
		[data-spot]:hover > .spot {
			opacity: 1;
		}
		/* The other cards dim a little so the hovered one stands out. */
		.pkg-grid:hover .pkg:not(:hover) {
			filter: saturate(0.75) brightness(0.8);
		}
		.pkg {
			filter: none;
		}
		.pkg:hover {
			translate: 0 -10px;
			scale: 1.02;
		}
		.pkg-basic:hover {
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 0.3),
				0 24px 50px -20px rgb(0 0 0 / 0.8),
				0 0 40px -12px rgb(140 170 255 / 0.6);
		}
		.pkg-pro:hover {
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 0.35),
				0 24px 60px -20px rgb(60 0 120 / 0.8),
				0 0 60px -6px rgb(170 80 255 / 0.9);
		}
		.pkg-premium:hover {
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 0.45),
				0 24px 60px -20px rgb(80 0 120 / 0.8),
				0 0 80px -4px rgb(240 80 230 / 1);
		}
		/* Price glows; the ticks light up one after another. */
		.pkg:hover .pkg-amount {
			text-shadow: 0 0 24px rgb(255 255 255 / 0.55);
		}
		.pkg:hover .pkg-features li::before {
			color: #fff;
			text-shadow: 0 0 10px rgb(255 255 255 / 0.9);
			scale: 1.2;
			transition-delay: calc(var(--j) * 60ms);
		}
		.pkg:hover .pkg-pill::after {
			translate: 120% 0;
		}
	}
	.pkg-grid .pkg {
		transition-property: opacity, transform, translate, scale, border-color, box-shadow, filter;
	}
	.pkg-amount {
		transition: text-shadow 0.4s;
	}
	.pkg-features li::before {
		display: inline-block;
		transition:
			scale 0.35s var(--ease-soft),
			color 0.3s,
			text-shadow 0.3s;
	}
	/* Light sweep across the pill on hover. */
	.pkg-pill {
		position: relative;
		overflow: hidden;
	}
	.pkg-pill::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.6) 50%, transparent 70%);
		translate: -120% 0;
		transition: translate 0.8s var(--ease-soft);
	}

	/* ---------- Edge highlight ----------
	   The card's border is drawn by two layers instead of a CSS border: .edge (light) underneath, and the card's
	   own fill (::after, background: inherit) 1.5px smaller on top of it — so only a 1.5px rim of .edge shows.
	   On hover the rim brightens and a hot spot follows the pointer (--sx/--sy) around the edge. */
	.edge {
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		background:
			radial-gradient(180px circle at var(--sx, 50%) var(--sy, 0%), transparent, transparent),
			linear-gradient(160deg, rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.12) 45%, rgb(255 255 255 / 0.3));
		transition: opacity 0.4s;
		pointer-events: none;
	}
	.pkg::after {
		content: '';
		position: absolute;
		inset: 1.5px;
		z-index: 0;
		border-radius: calc(22px - 1.5px);
		background: inherit;
		pointer-events: none;
	}
	.pkg-basic {
		--edge: 170 200 255;
	}
	.pkg-pro {
		--edge: 210 160 255;
	}
	.pkg-premium {
		--edge: 255 150 235;
	}
	@media (hover: hover) {
		.pkg:hover .edge {
			background:
				radial-gradient(170px circle at var(--sx, 50%) var(--sy, 0%), #fff, rgb(var(--edge) / 0.9) 30%, transparent 70%),
				linear-gradient(160deg, rgb(var(--edge) / 0.85), rgb(var(--edge) / 0.35) 50%, rgb(var(--edge) / 0.75));
		}
		/* Inner rim glow just inside the edge. */
		.pkg:hover::after {
			box-shadow: inset 0 0 22px -6px rgb(var(--edge) / 0.7);
		}
	}

	/* ---------- Pricing table: extra hover polish ---------- */
	@media (hover: hover) {
		.price-table tbody tr:hover .price {
			color: #fff;
			text-shadow: 0 0 10px rgb(255 255 255 / 0.45);
		}
		.price-table tbody tr:hover .price.is-pro {
			text-shadow: 0 0 14px rgb(140 190 255 / 0.9);
		}
		.price-table tbody tr:hover .svc {
			text-shadow: 0 0 10px rgb(255 255 255 / 0.35);
		}
	}
	.price-table .price,
	.price-table .svc {
		transition:
			translate 0.3s var(--ease-soft),
			text-shadow 0.3s;
	}
	/* Basic: dark glass. Pro: violet into blue. Premium: magenta into electric blue, glowing. */
	.pkg-basic {
		background: linear-gradient(170deg, #07071a 0%, #0b0b2a 60%, #141a5e 100%);
	}
	.pkg-pro {
		background: linear-gradient(165deg, #7a1fd6 0%, #5a1bb8 45%, #3a2cc9 100%);
	}
	.pkg-premium {
		background:
			radial-gradient(90% 60% at 0% 45%, rgb(255 60 200 / 0.75), transparent 70%),
			linear-gradient(160deg, #c026d3 0%, #8b2cf5 45%, #3b4dff 100%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.35),
			0 0 50px -10px rgb(200 70 255 / 0.85);
	}
	.pkg-pill {
		align-self: flex-start;
		padding: 0.35rem 1rem;
		border-radius: 0.65rem;
		font-size: 1.05rem;
		font-weight: 600;
		color: #fff;
		background: rgb(255 255 255 / 0.22);
		box-shadow: 0 0 18px -4px rgb(255 255 255 / 0.5);
	}
	.pkg-pro .pkg-pill {
		background: linear-gradient(90deg, #b62ad8, #8b2cf5);
	}
	.pkg-premium .pkg-pill {
		background: linear-gradient(90deg, #4f5bff, #c026d3);
	}
	.pkg-price {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		margin-top: 2rem;
	}
	.pkg-amount {
		font-family: var(--font-epic);
		font-weight: 800;
		font-size: clamp(2rem, 3.4vw, 2.8rem);
		line-height: 1;
		color: #fff;
	}
	.pkg-period {
		font-size: 0.85rem;
		color: rgb(255 255 255 / 0.75);
	}
	.pkg-features {
		display: grid;
		gap: 1rem;
		margin-top: 1.6rem;
		font-size: 0.95rem;
		line-height: 1.35;
		color: rgb(255 255 255 / 0.92);
	}
	.pkg-features li {
		position: relative;
		padding-left: 1.5rem;
	}
	.pkg-features li::before {
		content: '✓';
		position: absolute;
		left: 0;
		font-weight: 600;
	}

	/* ---------- Glass ---------- */
	/* Gradient border: bright at the top-left and the bottom-right corners. */
	.glass-panel,
	.tier-pro {
		position: relative;
	}
	.glass-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.06) 40%, rgb(255 255 255 / 0.04) 60%, rgb(120 190 255 / 0.55));
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		pointer-events: none;
	}
	.glass-panel {
		border-radius: 26px;
		background: linear-gradient(160deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.04) 45%, rgb(255 255 255 / 0.07));
		border: 1px solid transparent;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.18),
			0 30px 70px -30px rgb(0 0 0 / 0.75);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		backdrop-filter: blur(18px) saturate(140%);
	}
	.tier-pill {
		display: inline-block;
		padding: 0.35rem 0.9rem;
		border-radius: 0.6rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: #fff;
		background: rgb(255 255 255 / 0.18);
		border: 1px solid rgb(255 255 255 / 0.22);
	}
	.tier-pill.is-pro {
		background: linear-gradient(180deg, #3f78ff, #1e4dff);
		border-color: rgb(140 190 255 / 0.6);
		box-shadow: 0 0 18px -2px rgb(63 120 255 / 0.8);
	}
	@media (min-width: 40rem) {
		.tier-pill {
			padding: 0.45rem 1.4rem;
			font-size: 1rem;
		}
	}

	/* ---------- View 1: table ---------- */
	.price-table {
		table-layout: fixed;
		border-collapse: collapse;
	}
	.price-table th,
	.price-table td {
		padding: 0.8rem 0.25rem;
		font-size: 0.72rem;
		font-weight: 500;
		text-align: center;
		color: #fff;
	}
	.price-table thead th {
		padding-bottom: 1rem;
		text-align: center;
	}
	.price-table thead th:first-child {
		text-align: left;
		padding-left: 0.5rem;
	}
	.price-table tbody tr + tr {
		border-top: 1px solid rgb(255 255 255 / 0.16);
	}
	.price-table .num {
		font-size: 0.9rem;
		color: rgb(255 255 255 / 0.9);
	}
	.price-table .svc {
		text-align: left;
		line-height: 1.2;
	}
	.price-table .price.is-pro {
		font-weight: 600;
	}
	/* Row hover: a soft band across the row and the number lights up. */
	.price-table tbody tr {
		position: relative;
		transition: background 0.3s;
	}
	.price-table tbody td,
	.price-table tbody th {
		transition:
			color 0.3s,
			text-shadow 0.3s;
	}
	@media (hover: hover) {
		.price-table tbody tr:hover {
			background: linear-gradient(90deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.03));
		}
		.price-table tbody tr:hover .num {
			color: var(--color-cyan);
			text-shadow: 0 0 12px rgb(63 184 255 / 0.7);
		}
	}
	@media (min-width: 40rem) {
		.price-table th,
		.price-table td {
			padding: 0.85rem 0.5rem;
			font-size: 0.95rem;
		}
		.price-table .num {
			font-size: 1.15rem;
		}
	}
	/* Column backgrounds: a soft Basic column and a bright blue Pro column, as on the slide. */
	.col-bg {
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		border-radius: 18px;
	}
	.col-basic {
		left: calc(48% + 0.4rem);
		width: calc(24% - 0.8rem);
		background: rgb(255 255 255 / 0.06);
		border: 1px solid rgb(255 255 255 / 0.12);
	}
	.col-pro {
		left: calc(72% + 0.2rem);
		width: calc(28% - 0.9rem);
		overflow: hidden;
		background: linear-gradient(180deg, rgb(30 77 255 / 0.85), rgb(40 110 255 / 0.55));
		border: 1px solid rgb(130 185 255 / 0.55);
		box-shadow:
			0 0 40px -6px rgb(63 120 255 / 0.75),
			inset 0 1px 0 rgb(255 255 255 / 0.3);
	}
	/* A band of light running down the Pro column now and then. */
	.col-pro::after {
		content: '';
		position: absolute;
		inset: -40% 0 auto;
		height: 40%;
		background: linear-gradient(180deg, transparent, rgb(255 255 255 / 0.22), transparent);
		animation: sheen 5s ease-in-out infinite;
	}
	@keyframes sheen {
		0%,
		55% {
			translate: 0 0;
		}
		100% {
			translate: 0 360%;
		}
	}
	.col-bg {
		transition:
			background 0.4s,
			border-color 0.4s,
			box-shadow 0.4s,
			opacity 0.4s;
	}
	/* Hovering a tier lights its column up and dims the other one. */
	.pricing[data-tier='basic'] .col-basic {
		background: rgb(255 255 255 / 0.14);
		border-color: rgb(255 255 255 / 0.35);
		box-shadow: 0 0 30px -8px rgb(255 255 255 / 0.4);
	}
	.pricing[data-tier='basic'] .col-pro {
		opacity: 0.55;
	}
	.pricing[data-tier='pro'] .col-pro {
		box-shadow:
			0 0 60px -4px rgb(63 140 255 / 0.95),
			inset 0 1px 0 rgb(255 255 255 / 0.4);
	}
	.pricing[data-tier='pro'] .col-basic {
		opacity: 0.5;
	}
	@media (min-width: 40rem) {
		.col-bg {
			top: 0.9rem;
			bottom: 0.9rem;
		}
		.col-basic {
			left: calc(48% + 0.9rem);
			width: calc(24% - 1rem);
		}
		.col-pro {
			left: calc(72% + 0.9rem);
			width: calc(28% - 1.8rem);
		}
	}

	/* ---------- View 2: tiers ---------- */
	.tier {
		display: flex;
		flex-direction: column;
		padding: 1.4rem;
		transition:
			translate 0.5s var(--ease-soft),
			box-shadow 0.5s var(--ease-soft);
	}
	.tier .tier-pill {
		align-self: flex-start;
	}
	@media (hover: hover) {
		.tier:hover {
			translate: 0 -6px;
		}
	}
	.pricing[data-tier='basic'] .tier-pro,
	.pricing[data-tier='pro'] .tier-basic {
		opacity: 0.75;
	}
	.tier-basic,
	.tier-pro {
		transition:
			translate 0.5s var(--ease-soft),
			opacity 0.4s,
			box-shadow 0.5s var(--ease-soft);
	}
	.tier-pro {
		border-radius: 26px;
		background: linear-gradient(170deg, rgb(40 100 255 / 0.9), rgb(25 70 230 / 0.75) 55%, rgb(20 55 200 / 0.8));
		border: 1px solid rgb(140 190 255 / 0.55);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.3),
			0 0 60px -14px rgb(63 120 255 / 0.9);
	}
	.tier-title {
		margin-top: 1rem;
		font-family: var(--font-title);
		font-weight: 800;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		line-height: 0.95;
		text-transform: uppercase;
	}
	.tier-points {
		margin-top: 1.4rem;
		display: grid;
		gap: 0.85rem;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgb(255 255 255 / 0.88);
	}
	.tier-points li {
		position: relative;
		padding-left: 1.7rem;
	}
	/* Basic: a small ring. Pro: a check in a glowing circle. */
	.tier-points li::before {
		content: '';
		position: absolute;
		left: 0.2rem;
		top: 0.35em;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		border: 1.5px solid rgb(255 255 255 / 0.55);
	}
	.tier-points.is-checked li::before {
		content: '✓';
		left: 0;
		top: 0.05em;
		width: 1.15rem;
		height: 1.15rem;
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		font-weight: 700;
		color: #1e4dff;
		background: #fff;
		border: 0;
		box-shadow: 0 0 12px rgb(255 255 255 / 0.5);
	}
	/* "Best for…" pinned to the bottom of each card as a chip. */
	.best {
		margin-top: auto;
		padding-top: 1.4rem;
	}
	.best::before {
		content: '';
		display: block;
		height: 1px;
		margin-bottom: 1rem;
		background: linear-gradient(90deg, rgb(255 255 255 / 0.35), transparent);
	}
	.tier .best {
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.35;
		color: #fff;
	}
	@media (min-width: 40rem) {
		.tier {
			padding: 2rem;
		}
	}

	/* ---------- Switching views: a 3D turn ---------- */
	.panes {
		display: grid;
		perspective: 1600px;
	}
	.pane {
		grid-area: 1 / 1;
		transform-origin: 50% 50%;
		transition:
			transform 0.85s var(--ease-soft),
			opacity 0.6s var(--ease-soft),
			filter 0.6s var(--ease-soft);
	}
	.pane:not(.is-active) {
		opacity: 0;
		filter: blur(6px);
		pointer-events: none;
	}
	/* Leaving / arriving positions: turned away and shifted to one side. */
	.pane.at-left {
		transform: translateX(-16%) rotateY(32deg) scale(0.92);
	}
	.pane.at-right {
		transform: translateX(16%) rotateY(-32deg) scale(0.92);
	}
	.pane.no-anim {
		transition: none;
	}
	/* Phones: the views differ a lot in height, so the box follows the view that is showing
	   (the hidden one is taken out of the flow instead of reserving its height). */
	@media (max-width: 39.99rem) {
		.pane:not(.is-active) {
			position: absolute;
			inset: 0 0 auto 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.col-pro::after {
			animation: none;
		}
		.pkg {
			transition: opacity 0.4s;
		}

		.pane {
			transition: opacity 0.3s;
		}
		.pane.at-left,
		.pane.at-right {
			transform: none;
		}
	}

	/* ---------- Controls ---------- */
	.pricing-arrow {
		z-index: 3;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		color: #fff;
		background: rgb(255 255 255 / 0.14);
		border: 1px solid rgb(255 255 255 / 0.25);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6);
		transition:
			background 0.3s,
			scale 0.3s var(--ease-soft);
	}
	.pricing-arrow svg {
		width: 1rem;
	}
	.pricing-arrow:hover {
		background: rgb(255 255 255 / 0.26);
		scale: 1.06;
	}
	.pricing-arrow.is-prev {
		margin-right: 0.5rem;
	}
	.pricing-arrow.is-next {
		margin-left: 0.5rem;
	}
	@media (min-width: 40rem) {
		.pricing-arrow {
			position: absolute;
			top: calc(50% - 2.5rem);
			margin: 0 !important;
		}
		.pricing-arrow.is-prev {
			left: -0.9rem;
		}
		.pricing-arrow.is-next {
			right: -0.9rem;
		}
	}
	.pricing-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.35);
		transition:
			width 0.4s var(--ease-soft),
			background 0.3s;
	}
	.pricing-dot[aria-current] {
		width: 1.6rem;
		background: #fff;
	}
	.pricing-dot:hover {
		background: rgb(255 255 255 / 0.7);
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-pricing]');

	// Hovered tier → highlighted column/card.
	const pricing = document.querySelector<HTMLElement>('.pricing[data-tier]');
	if (pricing) {
		const table = pricing.querySelector<HTMLElement>('[data-table-panel]');
		const colBasic = pricing.querySelector<HTMLElement>('.col-basic');
		const colPro = pricing.querySelector<HTMLElement>('.col-pro');
		let tier = 'none';
		const setTier = (next: string) => {
			if (next === tier) return;
			tier = next;
			pricing.dataset.tier = next;
		};
		// Table: which column is under the pointer (cells and the gaps between rows both count).
		const fromTable = (e: PointerEvent) => {
			const x = e.clientX;
			const inCol = (el: HTMLElement | null) => {
				if (!el) return false;
				const r = el.getBoundingClientRect();
				return x >= r.left - 8 && x <= r.right + 8;
			};
			setTier(inCol(colPro) ? 'pro' : inCol(colBasic) ? 'basic' : 'none');
		};
		table?.addEventListener('pointermove', fromTable);
		table?.addEventListener('pointerdown', fromTable);
		table?.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && setTier('none'));
		// Tier cards.
		for (const card of pricing.querySelectorAll<HTMLElement>('[data-tier-zone]')) {
			card.addEventListener('pointerenter', () => setTier(card.dataset.tierZone!));
			card.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && setTier('none'));
		}
		// Touch: tapping elsewhere clears the highlight.
		document.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' && !pricing.contains(e.target as Node)) setTier('none');
		});
	}

	// Pointer spotlight on the pricing panel and the package cards.
	for (const el of document.querySelectorAll<HTMLElement>('#services [data-spot]')) {
		el.addEventListener('pointermove', (e) => {
			const r = el.getBoundingClientRect();
			el.style.setProperty('--sx', `${e.clientX - r.left}px`);
			el.style.setProperty('--sy', `${e.clientY - r.top}px`);
		});
	}

	// Fit each big title ("PRICING", "PACKAGES") exactly to its column, whatever the font's letter widths.
	// Re-fits whenever the text changes size (e.g. when the Epic Pro font finishes loading) or the window resizes.
	const titles = [...document.querySelectorAll<HTMLElement>('#services [data-fit]')];
	const fit = (el: HTMLElement) => {
		// offsetWidth = layout width, unaffected by the section's 3D scroll transform.
		const text = (el.firstElementChild as HTMLElement).offsetWidth;
		const box = el.clientWidth;
		if (!text || !box) return;
		const size = parseFloat(getComputedStyle(el).fontSize);
		const next = Math.min((size * box * 0.99) / text, window.innerHeight * 0.2);
		if (Math.abs(next - size) > 0.5) el.style.fontSize = `${next}px`;
	};
	const ro = new ResizeObserver((entries) =>
		entries.forEach((e) => fit((e.target as HTMLElement).closest<HTMLElement>('[data-fit]')!)),
	);
	for (const el of titles) {
		ro.observe(el.firstElementChild!);
		ro.observe(el);
	}
	document.fonts?.ready.then(() => titles.forEach(fit));

	if (root) {
		const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
		let current = 0;
		let busy = false;

		// Turn to view `next`: the current view swings away to one side while the next swings in from the other.
		const go = (next: number, dir = next > current ? 1 : -1) => {
			next = (next + panes.length) % panes.length;
			if (next === current || busy) return;
			busy = true;
			const out = panes[current];
			const inc = panes[next];
			const away = dir > 0 ? 'at-left' : 'at-right';
			const from = dir > 0 ? 'at-right' : 'at-left';

			// Place the incoming view on its starting side without animating, then let it swing in.
			inc.classList.add('no-anim', from);
			inc.offsetWidth; // apply the starting position before transitioning
			inc.classList.remove('no-anim');
			out.classList.add(away);
			out.classList.remove('is-active');
			inc.classList.add('is-active');
			inc.classList.remove(from);
			out.inert = true;
			inc.inert = false;

			dots.forEach((d, i) => (i === next ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
			current = next;
			setTimeout(() => {
				out.classList.add('no-anim');
				out.classList.remove(away);
				out.offsetWidth;
				out.classList.remove('no-anim');
				busy = false;
			}, 850);
		};

		root.querySelector('[data-prev]')!.addEventListener('click', () => go(current - 1, -1));
		root.querySelector('[data-next]')!.addEventListener('click', () => go(current + 1, 1));
		dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

		// Arrow keys while focus is inside the carousel.
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') go(current + 1, 1);
			if (e.key === 'ArrowLeft') go(current - 1, -1);
		});

		// Swipe on touch screens.
		let startX = 0;
		let startY = 0;
		root.addEventListener('pointerdown', (e) => {
			startX = e.clientX;
			startY = e.clientY;
		});
		root.addEventListener('pointerup', (e) => {
			if (e.pointerType === 'mouse') return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) go(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
		});
	}
</script>
